PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=your-sandbox-rest-app-client-id
PAYPAL_CLIENT_SECRET=your-sandbox-rest-app-client-secret

OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-4o-mini

# Local browser return/cancel URLs. localhost is OK because PayPal redirects the buyer's browser.
APP_BASE_URL=http://localhost:3000
PORT=3000

# Required for real PayPal webhook delivery. Use an HTTPS tunnel URL with no trailing slash.
# Example: https://your-public-tunnel.example.com
PAYPAL_WEBHOOK_URL=

# Set after creating a webhook subscription for PAYMENT.CAPTURE.COMPLETED.
PAYPAL_WEBHOOK_ID=your-paypal-sandbox-webhook-id
